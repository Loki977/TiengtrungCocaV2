{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiengtrungcoca.vn/schemas/mock-exam-v2.schema.json",
  "title": "Tiếng Trung Cô Ca mock exam v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "levelNumber",
    "standardVersion",
    "status",
    "sections",
    "answerKeyPath"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "levelNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "standardVersion": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "published",
        "archived"
      ]
    },
    "answerKeyPath": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "durationMinutes",
          "questionCount",
          "parts"
        ],
        "properties": {
          "id": {
            "enum": [
              "listening",
              "reading",
              "writing"
            ]
          },
          "durationMinutes": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "parts": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  }
}
