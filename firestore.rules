rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn()
        && (
          request.auth.token.role == "super_admin"
          || request.auth.token.email == "nqthanhforwork@gmail.com"
        );
    }

    function isAdmin() {
      return isSignedIn()
        && (
          isSuperAdmin()
          || request.auth.token.role == "admin"
        );
    }

    function isCmsEditor() {
      return isSignedIn()
        && (
          isAdmin()
          || request.auth.token.role == "editor"
        );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validPublicUserCreate(uid) {
      return request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && (!request.resource.data.keys().hasAny(['email'])
          || request.resource.data.email == request.auth.token.email);
    }

    function validPublicUserUpdate(uid) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'email', 'photoURL', 'updatedAt'
        ])
        && (!request.resource.data.keys().hasAny(['uid'])
          || request.resource.data.uid == uid)
        && (!request.resource.data.keys().hasAny(['email'])
          || request.resource.data.email == request.auth.token.email);
    }

    function allowedProgressKeys() {
      return [
        'xp', 'coins', 'totalCoinsEarned',
        'unlockedLessons', 'writingCompleted', 'challengeStats', 'coinHistory',
        'checkInStreak', 'lastCheckInDate', 'streak',
        'completedLessons', 'completedLessonIds',
        'currentLevel', 'currentLesson', 'courses', 'tasks', 'history',
        'dailyGoal', 'todayXp', 'weeklyLessons', 'lastXp', 'studyHours',
        'levelPercent', 'xpToNext',
        'createdAt', 'updatedAt'
      ];
    }

    function validStatsCreate() {
      // hasOnly() also blocks users from inventing future privilege fields.
      return request.resource.data.keys().hasOnly(allowedProgressKeys());
    }

    function validStatsUpdate() {
      // Only progress fields may change. Existing admin-managed VIP fields can
      // remain in the document, but an owner cannot add, edit or remove them.
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(allowedProgressKeys());
    }

    match /feedbacks/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /accessLogs/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /visits/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /analytics/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /adminAuditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /writingSubmissions/{submissionId} {
      // Bài tự luận chỉ được tạo/chấm qua backend đã xác thực và có rate limit.
      // Người học chỉ đọc được bài của chính mình; CMS dùng custom claim.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /writingGradingCache/{hash} {
      allow read, write: if false;
    }

    match /writingRateLimits/{bucketId} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow create: if isOwner(uid) && validPublicUserCreate(uid);
      allow read: if isAdmin() || isOwner(uid);
      allow update: if isOwner(uid) && validPublicUserUpdate(uid);
      allow delete: if isOwner(uid);

      match /private/stats {
        allow read: if isAdmin() || isOwner(uid);
        allow create: if isOwner(uid) && validStatsCreate();
        allow update: if isOwner(uid) && validStatsUpdate();
        // Giữ luồng tự xóa tài khoản hiện có; create/update vẫn không thể chạm VIP.
        allow delete: if isOwner(uid);
      }

      match /private/hskPlacement {
        // Trạng thái điều phối placement chỉ được backend tin cậy quản lý.
        allow read, write: if false;
      }

      match /private/{docId} {
        // stats is handled by the stricter rule above. Other private documents
        // contain personal preferences/saved words and never grant privileges.
        allow create, read, update, delete: if docId != 'stats'
          && docId != 'hskPlacement'
          && (isAdmin() || isOwner(uid));
      }

      match /hskPlacementAttempts/{attemptId} {
        // Attempt chứa posterior, câu đã dùng và kết quả chấm riêng tư.
        allow read, write: if false;
      }

      match /mockExamAttempts/{attemptId} {
        // Đề không có tự luận giữ luồng lưu kết quả hiện tại; kết quả đã tạo
        // không thể bị client sửa. Đề có tự luận được backend tạo và cập nhật.
        allow read: if isAdmin() || isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.attemptId == attemptId
          && request.resource.data.examId is string;
        allow update, delete: if false;
      }
    }

    match /adminSettings/{docId} {
      allow read: if true;
      allow write: if isCmsEditor();
    }

    match /lessonOverrides/{docId} {
      allow read: if true;
      allow write: if isCmsEditor();
    }

    match /writingLessonOverrides/{docId} {
      allow read: if true;
      allow write: if isCmsEditor();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isCmsEditor();

      match /lessons/{lessonId} {
        allow read: if true;
        allow write: if isCmsEditor();
      }
    }

    match /lessonContents/{lessonId} {
      allow read: if true;
      allow write: if isCmsEditor();
    }

    match /cmsSettings/{docId} {
      allow read: if true;
      allow write: if isCmsEditor();
    }

    match /{document=**} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
  }
}
